# Copiá estas variables en Vercel > Settings > Environment Variables.
# Sin SUPABASE_URL ni SUPABASE_SERVICE_ROLE_KEY la tienda funciona en modo demo (datos de ejemplo).

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña para entrar a /admin
ADMIN_PASSWORD=elegi-una-contraseña-larga
